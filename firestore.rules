rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two authorized people: signed in, verified email and the custom claim `household`
    // (set with scripts/grant-access.js).
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.household == true;
    }

    // The ingestion service writes with the Admin SDK, which bypasses these rules.
    // Values are validated by the app; the rules only guard the shape and the bank data.
    function monthKeysOk(d) {
      return d.keys().hasOnly(['purchases', 'edits', 'incomes', 'savings', 'fixed',
        'rate', 'rateInherited', 'cap', 'capInherited']);
    }

    // One document per month. The web never writes `purchases` (bank data, ingestion only).
    match /months/{month} {
      allow read: if isHousehold();
      allow create: if isHousehold()
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && monthKeysOk(request.resource.data)
        && (!('purchases' in request.resource.data)
          || (request.resource.data.purchases is map && request.resource.data.purchases.size() == 0));
      allow update: if isHousehold()
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && monthKeysOk(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['purchases']);
      allow delete: if false;
    }

    // `seenCards` is written only by the ingestion service.
    match /config/cards {
      allow read: if isHousehold();
      allow create: if isHousehold()
        && request.resource.data.keys().hasOnly(['accounts', 'cards', 'cycles', 'seenCards'])
        && (!('seenCards' in request.resource.data)
          || (request.resource.data.seenCards is map && request.resource.data.seenCards.size() == 0));
      allow update: if isHousehold()
        && request.resource.data.keys().hasOnly(['accounts', 'cards', 'cycles', 'seenCards'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seenCards']);
      allow delete: if false;
    }

    match /config/months {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list;
      allow delete: if false;
    }

    match /config/{doc} {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && doc in ['categories', 'fixedTypes', 'merchants']
        && request.resource.data.keys().hasOnly(['items']);
      allow delete: if false;
    }

    match /meta/uncategorized {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && request.resource.data.keys().hasOnly(['items']);
      allow delete: if false;
    }

    // Everything else (including state/sync and the old collections) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
