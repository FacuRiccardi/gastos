rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two authorized people: signed in, verified email and the custom claim `household`
    // (set with scripts/grant-access.js).
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.household == true;
    }

    // The ingestion service writes with the Admin SDK, which bypasses these rules.
    // From a browser the expenses are read-only, except for their category.
    match /expenses/{expenseId} {
      allow read: if isHousehold();
      allow create, delete: if false;
      allow update: if isHousehold()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categoryId'])
        && (!('categoryId' in request.resource.data)
          || request.resource.data.categoryId == null
          || (request.resource.data.categoryId is string
            && request.resource.data.categoryId.size() >= 1
            && request.resource.data.categoryId.size() <= 100));
    }

    // Categories (name + tag color), edited by hand from the web app.
    match /categories/{categoryId} {
      function validCategory(d) {
        return d.keys().hasOnly(['name', 'color'])
          && d.keys().hasAll(['name', 'color'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$');
      }
      allow read: if isHousehold();
      allow create, update: if isHousehold() && validCategory(request.resource.data);
      allow delete: if isHousehold();
    }

    function validText(v) {
      return v is string && v.size() >= 1 && v.size() <= 40;
    }

    function validDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function accountExists(accountId) {
      return accountId is string && accountId.size() >= 1 && accountId.size() <= 100
        && exists(/databases/$(database)/documents/accounts/$(accountId));
    }

    // Accounts, cards and statement cycles, edited by hand from the web app.
    match /accounts/{accountId} {
      allow read: if isHousehold();
      allow create: if isHousehold()
        && request.resource.data.keys().hasOnly(['name', 'owner'])
        && request.resource.data.keys().hasAll(['name', 'owner'])
        && validText(request.resource.data.name)
        && validText(request.resource.data.owner);
      allow update: if isHousehold()
        && request.resource.data.keys().hasOnly(['name', 'owner'])
        && request.resource.data.keys().hasAll(['name', 'owner'])
        && validText(request.resource.data.name)
        && validText(request.resource.data.owner);
      allow delete: if isHousehold();
    }

    // The ID is `${last4}_${type}`.
    match /cards/{cardId} {
      function validCard(d) {
        return d.keys().hasOnly(['last4', 'type', 'holder', 'accountId'])
          && d.keys().hasAll(['last4', 'type', 'holder', 'accountId'])
          && d.last4 is string && d.last4.matches('^[0-9]{4}$')
          && d.type in ['credit', 'debit']
          && validText(d.holder)
          && cardId == d.last4 + '_' + d.type
          && accountExists(d.accountId);
      }
      allow read: if isHousehold();
      allow create: if isHousehold() && validCard(request.resource.data);
      // last4 and type are part of the ID, so only holder and accountId may change.
      allow update: if isHousehold() && validCard(request.resource.data)
        && request.resource.data.last4 == resource.data.last4
        && request.resource.data.type == resource.data.type;
      allow delete: if isHousehold();
    }

    // The ID is `${accountId}_${closingDate}`. Cycles are immutable: no updates, which also makes
    // writing over an existing cycle (a duplicate closing date) impossible.
    match /cycles/{cycleId} {
      allow read: if isHousehold();
      allow create: if isHousehold()
        && request.resource.data.keys().hasOnly(['accountId', 'closingDate', 'dueDate'])
        && request.resource.data.keys().hasAll(['accountId', 'closingDate', 'dueDate'])
        && validDate(request.resource.data.closingDate)
        && (request.resource.data.dueDate == null
          || (validDate(request.resource.data.dueDate)
            && request.resource.data.dueDate >= request.resource.data.closingDate))
        && request.resource.data.accountId is string
        && cycleId == request.resource.data.accountId + '_' + request.resource.data.closingDate
        && accountExists(request.resource.data.accountId);
      allow update: if false;
      allow delete: if isHousehold();
    }

    // Merchant -> category dictionary. The ID is the merchant key (see merchantKey); the ingestion
    // service reads it with the Admin SDK and the web app writes it when a purchase is categorized.
    match /merchantCategories/{key} {
      function validMerchantCategory(d) {
        return d.keys().hasOnly(['merchant', 'categoryId'])
          && d.keys().hasAll(['merchant', 'categoryId'])
          && d.merchant is string && d.merchant.size() >= 1 && d.merchant.size() <= 200
          && d.categoryId is string && d.categoryId.size() >= 1 && d.categoryId.size() <= 100;
      }
      allow read: if isHousehold();
      allow create, update: if isHousehold() && key.matches('^[a-z0-9-]{1,100}$') && validMerchantCategory(request.resource.data);
      allow delete: if isHousehold();
    }

    // Fixed monthly expenses: the kinds ("Alquiler", ...) and what was paid for each one in a month.
    // The entry ID is `${typeId}_${month}`, so there is at most one per type and month.
    // A type is never deleted: it is disabled (soft delete) and can be enabled again.
    match /fixedTypes/{typeId} {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && request.resource.data.keys().hasOnly(['name', 'disabled'])
        && request.resource.data.keys().hasAll(['name'])
        && validText(request.resource.data.name)
        && (!('disabled' in request.resource.data) || request.resource.data.disabled is bool);
      allow delete: if false;
    }
    match /fixedExpenses/{entryId} {
      function validFixedEntry(d) {
        return d.keys().hasOnly(['typeId', 'month', 'amount'])
          && d.keys().hasAll(['typeId', 'month', 'amount'])
          && d.typeId is string && d.typeId.size() >= 1 && d.typeId.size() <= 100
          && d.month is string && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d.amount is number && d.amount > 0
          && entryId == d.typeId + '_' + d.month
          && exists(/databases/$(database)/documents/fixedTypes/$(d.typeId))
          // nothing new can be loaded for a disabled type
          && get(/databases/$(database)/documents/fixedTypes/$(d.typeId)).data.get('disabled', false) == false;
      }
      allow read: if isHousehold();
      allow create, update: if isHousehold() && validFixedEntry(request.resource.data);
      allow delete: if isHousehold();
    }

    // Dollar-to-peso rate of each month ("TC día de cobro"). The ID is the month.
    match /exchangeRates/{month} {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['rate'])
        && request.resource.data.rate is number && request.resource.data.rate > 0;
      allow delete: if isHousehold();
    }

    // Spending cap of each month ("Tope de gasto"), in pesos. The ID is the month.
    match /spendingCaps/{month} {
      allow read: if isHousehold();
      allow create, update: if isHousehold()
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['amount'])
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow delete: if isHousehold();
    }

    // Incomes and savings: an amount in pesos or dollars on a day, entered by hand.
    function validEntry(d) {
      return d.keys().hasOnly(['amount', 'currency', 'date'])
        && d.keys().hasAll(['amount', 'currency', 'date'])
        && d.amount is number && d.amount > 0
        && d.currency in ['ARS', 'USD']
        && validDate(d.date);
    }
    // Incomes also say whose they are.
    function validIncome(d) {
      return d.keys().hasOnly(['amount', 'currency', 'date', 'owner'])
        && d.keys().hasAll(['amount', 'currency', 'date', 'owner'])
        && d.amount is number && d.amount > 0
        && d.currency in ['ARS', 'USD']
        && validDate(d.date)
        && d.owner is string && d.owner.size() >= 1 && d.owner.size() <= 40;
    }
    match /incomes/{entryId} {
      allow read: if isHousehold();
      allow create, update: if isHousehold() && validIncome(request.resource.data);
      allow delete: if isHousehold();
    }
    match /savings/{entryId} {
      allow read: if isHousehold();
      allow create, update: if isHousehold() && validEntry(request.resource.data);
      allow delete: if isHousehold();
    }

    // Everything else (including state/sync) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
