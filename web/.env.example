# Firebase web config (copy to .env, which is git-ignored). Values come from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise site key): Firebase console > App Check > Apps > Web app > reCAPTCHA Enterprise. Leave empty to disable.
VITE_APPCHECK_SITE_KEY=
# The people whose incomes are tracked, separated by commas (for example Ana,Beto).
VITE_OWNERS=
