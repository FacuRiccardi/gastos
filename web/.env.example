# Firebase web config (copy to .env, which is git-ignored). Values come from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging (cap notifications): Firebase console > Project settings > Cloud Messaging. The sender id is on that page; the VAPID key comes from Web Push certificates > Generate key pair.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# The people whose incomes are tracked, separated by commas (for example Ana,Beto).
VITE_OWNERS=
